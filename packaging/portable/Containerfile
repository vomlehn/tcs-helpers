# The portable build: a system old enough that what is built on it runs on
# every system the TCS packages are meant for. A program needs a C library
# at least as new as the one it was linked against, so the packages are
# built here, on Ubuntu 22.04's glibc 2.35, rather than on whatever newer
# system the developer has: they then install on Ubuntu 22.04 and later,
# Debian 12 and a current Fedora. Its Python, 3.10, is the oldest any TCS
# project's Python asks for.
#
# What is here is what building and packaging every TCS project needs,
# the union of the lists in their bin/install-tools; checking them, which
# needs newer tools, stays on the developer's own system. Rust comes from
# rustup, as Ubuntu's lags behind what the projects need; its toolchain is
# in /opt, readable by whoever the build runs as, and each build's own
# downloads go in CARGO_HOME, which portable.sh points at a volume.
FROM docker.io/library/ubuntu:22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update \
 && apt-get install -y --no-install-recommends \
	build-essential binutils pkg-config libfontconfig-dev make git \
	python3 python3-pip python3-setuptools python3-venv python3-yaml \
	python3-tk python3-docutils pandoc libxml2-utils bsdextrautils \
	curl ca-certificates dpkg-dev rpm gzip xz-utils file \
 && apt-get clean \
 && rm -rf /var/lib/apt/lists/*

# Ubuntu 22.04's setuptools, 59, predates the pyproject.toml metadata the
# projects' Python packages are described with, and pip, given it, makes a
# package named UNKNOWN; tcs-xtce's asks for 77 or later. Newer ones, from
# PyPI, are installed under /usr/local for the build alone: what is built
# still runs on the system's Python.
RUN python3 -m pip install --no-cache-dir --upgrade pip 'setuptools>=77'

ENV RUSTUP_HOME=/opt/rustup \
	PATH=/opt/cargo/bin:$PATH
RUN curl -fsSL https://sh.rustup.rs \
	| CARGO_HOME=/opt/cargo sh -s -- -y --no-modify-path \
		--profile minimal --default-toolchain stable \
 && chmod -R a+rX /opt/rustup /opt/cargo
