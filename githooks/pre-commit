#!/bin/sh
# The pre-commit hook of a TCS project. A project sets git's core.hooksPath
# to this directory with `make hooks`.
#
# First the names and the categories. Where the commit changes something
# operational-names reads -- a Cargo manifest or lock file, a
# pyproject.toml, Python or categories.toml -- or adds a file, and the
# project's Makefile has an operational-names target, that target is run,
# and the commit is refused if operational code would be built from code
# with a non-operational name, or a directory is in no category.
#
# Then the pages: each page of a source the commit changes is rebuilt and
# added to it.

set -e

names='(^|/)(Cargo\.(toml|lock)|pyproject\.toml)$|\.py$|^categories\.toml$'
if { git diff --cached --name-only --diff-filter=ACMR | grep -qE "$names" ||
     [ -n "$(git diff --cached --name-only --diff-filter=A)" ]; } &&
   make -n operational-names > /dev/null 2>&1; then
	make --no-print-directory -s operational-names
fi

exec "$(dirname "$0")/../bin/html-pages" stage
