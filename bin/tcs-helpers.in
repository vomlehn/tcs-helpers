#!/bin/sh
# tcs-helpers: says which tcs-helpers is installed and where its data is,
# and checks that it is new enough for a project that uses it.
#
#   tcs-helpers --version          print the installed version
#   tcs-helpers --datadir          print the directory holding its data
#   tcs-helpers --require VERSION  exit 0 if the installed version is at
#                                  least VERSION, else say so and exit 1
#
# `make install` writes this file from bin/tcs-helpers.in, filling in the
# version and the data directory.

set -eu

VERSION="@VERSION@"
DATADIR="@DATADIR@"

# Prints how to call this command.
usage() {
	echo "usage: tcs-helpers --version | --datadir | --require VERSION"
}

# Tells whether one version is at least another.
#
# Arguments:
#   $1  The version installed, as MAJOR.MINOR.PATCH.
#   $2  The version required, in the same form.
#
# Returns:
#   0 if $1 is $2 or later, 1 otherwise.
at_least() {
	[ "$(printf '%s\n%s\n' "$2" "$1" | sort -V | head -n 1)" = "$2" ]
}

if [ $# -eq 0 ]; then
	usage >&2
	exit 2
fi
case "$1" in
--version)
	echo "$VERSION"
	;;
--datadir)
	echo "$DATADIR"
	;;
--require)
	if [ $# -ne 2 ]; then
		usage >&2
		exit 2
	fi
	if ! printf '%s\n' "$2" | grep -Eq '^[0-9]+\.[0-9]+\.[0-9]+$'; then
		echo "tcs-helpers: '$2' is not a version: MAJOR.MINOR.PATCH" >&2
		exit 2
	fi
	if ! at_least "$VERSION" "$2"; then
		echo "tcs-helpers: version $VERSION is installed and $2 is" \
		     "required: run make install in tcs-helpers" >&2
		exit 1
	fi
	;;
-h | --help)
	usage
	;;
*)
	usage >&2
	exit 2
	;;
esac
